#!/bin/sh
# castalia-session — the Castalia user session manager (Phase 0 skeleton).
#
# Bible §6.6 / §7.1: launched by the greeter (see castalia.desktop), it
# applies the active theme, starts the window manager and the shell
# processes, and SUPERVISES them — a crash in one piece never blacks out
# the desktop; each process restarts in about a second. Logout is a clean
# teardown via SIGTERM.
#
# POSIX sh only (Bible §12): no bashisms, auditable in one read.

set -u

PREFIX="${CASTALIA_PREFIX:-/opt/castalia}"
REPO="${CASTALIA_REPO:-$PREFIX/share/castalia}"
# Export the resolved asset tree so everything the session spawns inherits it
# — crucially the panel's Start Menu, which launches apps with the repo from
# its ENVIRONMENT (CastaliaMenu.cpp), not the --repo we pass here. Without this
# an installed session started by a display manager (Exec=castalia-session,
# no CASTALIA_REPO set) would launch every menu app with "--repo ." and fail
# to find /usr/share/castalia. The live path already exports it; this makes
# the greeter path behave identically.
export CASTALIA_REPO="$REPO"
# Publish our own pid so the session/power dialog (castalia-salir, §7.6) can
# log out by signalling exactly this session — the TERM trap below does the
# clean teardown — instead of pattern-matching processes.
export CASTALIA_SESSION_PID="$$"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}/castalia-session.$$"
mkdir -p "$RUNTIME"

log() { printf 'castalia-session: %s\n' "$*" >&2; }

# ------------------------------------------------------------ safe mode --
# The GRUB "Modo seguro" entry (iso/grub/11_castalia_safe) boots with
# castalia.safemode=1 on the kernel command line. It is read here — the same
# way the live image reads castalia.installer= — because a boot entry that
# nothing acts on is just a differently-worded normal boot.
#
# Safe Mode is for the machine you cannot get a desktop out of: strip the
# session down to what is needed to see a window and fix something, and leave
# the rest off. CASTALIA_SAFE_MODE=1 forces it without rebooting, which is how
# the tests exercise it.
SAFE_MODE="${CASTALIA_SAFE_MODE:-0}"
if [ "$SAFE_MODE" != "1" ] &&
   grep -qw 'castalia.safemode=1' /proc/cmdline 2>/dev/null; then
    SAFE_MODE=1
fi
if [ "$SAFE_MODE" = "1" ]; then
    export CASTALIA_SAFE_MODE=1
    # No animation anywhere (Theme.cpp reads this), and no audio: on a machine
    # that boots to a black screen the sound stack is a suspect too, and a
    # blocking player would take the session down with it.
    export CASTALIA_REDUCE_MOTION=1
    export CASTALIA_NO_SOUND=1
    log "SAFE MODE: animations and sounds off, optional services not started"
fi

# ---------------------------------------------------------------- theme --
# The active theme id comes from the user's config (falls back to the
# system default, then to classic). One switch themes everything (§6.16).
theme_from() {
    [ -r "$1" ] && sed -n 's/^[[:space:]]*id[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$1" | head -n 1
}
THEME="$(theme_from "$HOME/.config/castalia/theme.conf")"
[ -n "${THEME:-}" ] || THEME="$(theme_from /etc/castalia/theme.conf)"
[ -n "${THEME:-}" ] || THEME="classic"
# In Safe Mode the user's theme is not honoured: High Contrast is the one that
# stays readable on a generic framebuffer at whatever resolution nomodeset
# gives us, and it is the cheapest to paint.
if [ "$SAFE_MODE" = "1" ] && [ "$THEME" != "high-contrast" ]; then
    log "safe mode: overriding theme $THEME -> high-contrast"
    THEME="high-contrast"
fi
export CASTALIA_THEME="$THEME"
log "theme: $THEME"

# Openbox reads its themerc from the theme dir generated by
# tools/theme_export.py and installed by the theme package.
OB_THEME="Castalia-$THEME"
if [ -d "$HOME/.local/share/themes/$OB_THEME/openbox-3" ] ||
   [ -d "/usr/share/themes/$OB_THEME/openbox-3" ]; then
    export CASTALIA_OB_THEME="$OB_THEME"
fi

# The window-manager configuration: decorations + the §7.7 global keyboard
# map. We ship it inside our own asset tree rather than at
# /etc/xdg/openbox/rc.xml, because that path is owned by the openbox package
# and writing it from castalia-desktop makes dpkg refuse to unpack openbox.
# So we point openbox at our copy explicitly — unless the user has their own
# ~/.config/openbox/rc.xml, which always wins (§7.7: all rebindable; copy
# ours there and edit it).
OB_ARGS=""
if [ ! -r "$HOME/.config/openbox/rc.xml" ] &&
   [ -r "$REPO/openbox/rc.xml" ]; then
    OB_ARGS="--config-file $REPO/openbox/rc.xml"
    log "openbox config: $REPO/openbox/rc.xml"
fi

# ---------------------------------------------------------------- cursor --
# The Castalia pointer theme (tools/cursor_gen.py). Toolkits read
# XCURSOR_THEME/XCURSOR_SIZE from the environment, so exporting them here
# themes every client the session spawns. Only set when the theme is really
# installed, so a build without it keeps the stock pointers (§8.4).
CURSOR_THEME=Castalia-Human
for d in "$HOME/.icons/$CURSOR_THEME" "/usr/share/icons/$CURSOR_THEME"; do
    if [ -d "$d/cursors" ]; then
        export XCURSOR_THEME="$CURSOR_THEME"
        export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
        log "cursors: $CURSOR_THEME (${XCURSOR_SIZE}px)"
        break
    fi
done

# ------------------------------------------------------------ supervision --
# supervise NAME CMD [ARGS...] — restart-on-crash with a 1 s backoff,
# stopping cleanly once the session is shutting down (§7.1).
supervise() {
    name=$1
    shift
    (
        while :; do
            "$@"
            code=$?
            [ -e "$RUNTIME/stop" ] && exit 0
            log "$name exited (code $code); restarting in 1s"
            sleep 1
        done
    ) &
    printf '%s\n' "$!" > "$RUNTIME/$name.pid"
    log "started $name (pid $!)"
}

# ---------------------------------------------------------------- sound --
# The system sound scheme (§21.4). This mirrors the policy in
# libcastalia-ui's Sound.cpp — which is the canonical implementation the
# apps use — because the session is POSIX sh and cannot link it: honour the
# CASTALIA_NO_SOUND kill switch and the user's sound.conf, pick whichever
# player exists, and stay silent (never fail) when there is no audio stack.
sound_enabled() {
    [ "${CASTALIA_NO_SOUND:-0}" = "1" ] && return 1
    if [ -r "$HOME/.config/castalia/sound.conf" ] &&
       grep -qiE '^[[:space:]]*enabled[[:space:]]*=[[:space:]]*"?(false|0|no)"?' \
            "$HOME/.config/castalia/sound.conf"; then
        return 1
    fi
    return 0
}
play_sound() {
    sound_enabled || return 0
    wav="$REPO/branding/sound/wav/$1.wav"
    [ -r "$wav" ] || return 0
    if command -v paplay >/dev/null 2>&1; then paplay "$wav" >/dev/null 2>&1 &
    elif command -v pw-play >/dev/null 2>&1; then pw-play "$wav" >/dev/null 2>&1 &
    elif command -v aplay >/dev/null 2>&1; then aplay -q "$wav" >/dev/null 2>&1 &
    fi
    return 0
}

shutdown_session() {
    log "logout requested; stopping session"
    # Play the farewell before tearing anything down, and give it a moment —
    # otherwise the player dies with the session and is never heard.
    play_sound shutdown
    sound_enabled && sleep 1
    : > "$RUNTIME/stop"
    for pidfile in "$RUNTIME"/*.pid; do
        [ -r "$pidfile" ] || continue
        kill "$(cat "$pidfile")" 2>/dev/null || :
    done
}
trap shutdown_session TERM INT

# ---------------------------------------------------------------- startup --
# Order per §7.1: WM first (windows always manageable), then the desktop
# plane (wallpaper + icons, bottom layer), then the panel (dock).
# shellcheck disable=SC2086  # OB_ARGS is a deliberate two-word flag pair
supervise openbox openbox $OB_ARGS
if [ -x "$PREFIX/bin/castalia-desktop" ]; then
    supervise desktop "$PREFIX/bin/castalia-desktop" \
        --theme "$THEME" --repo "$REPO"
fi
if [ -x "$PREFIX/bin/castalia-panel" ]; then
    supervise panel "$PREFIX/bin/castalia-panel" \
        --theme "$THEME" --repo "$REPO"
fi
# The notification server (§7.4). It owns org.freedesktop.Notifications, so
# anything on the system — an apt hook, a first-party app, notify-send — can
# reach the user. Started after the panel so its toasts can measure the strut.
if [ "$SAFE_MODE" != "1" ] &&
   [ -x "$PREFIX/bin/castalia-notificaciones" ]; then
    supervise notificaciones "$PREFIX/bin/castalia-notificaciones" \
        --theme "$THEME" --repo "$REPO"
fi
[ -x "$PREFIX/bin/castalia-panel" ] || log "shell not installed; WM only"

# The desktop is up: greet the user (§21.4). Fire-and-forget.
play_sound startup

# The boot menu's "Instalar Castalia OS" entry lands here: the live desktop
# comes up normally and the installer opens on top of it a moment later, so
# the machine you are about to install onto is one you have already seen
# working (§14.5). It is supervised like everything else — closing the
# installer leaves you in the live session rather than in nothing.
if [ "${CASTALIA_AUTOSTART_INSTALLER:-0}" = "1" ] \
   && [ -x "$PREFIX/bin/castalia-instalador" ]; then
    log "boot menu asked for the installer; opening it over the live desktop"
    ( sleep 3
      "$PREFIX/bin/castalia-instalador" --theme "$THEME" --repo "$REPO" &
    ) &
fi

# Live/demo welcome: when CASTALIA_DEMO=1 (set by the live launcher), open a
# couple of first-party windows a moment after the desktop settles, so the
# first impression shows the OS in use. Never runs on an installed system.
if [ "${CASTALIA_DEMO:-0}" = "1" ]; then
    if [ "${CASTALIA_DEMO_WINE:-0}" = "1" ] \
       && [ -f "$PREFIX/share/win32-demo/hello.exe" ]; then
        # compat edition: open the Wine manager and run a REAL Win32 app
        # Suppress the first-run Mono/Gecko prompts so the demo never blocks;
        # hello.exe only needs user32/gdi32 anyway.
        export WINEPREFIX="$HOME/.wine"
        export WINEDEBUG=-all
        export WINEDLLOVERRIDES="mscoree,mshtml="
        ( sleep 3
          [ -x "$PREFIX/bin/castalia-wine" ] &&
              "$PREFIX/bin/castalia-wine" --theme "$THEME" --repo "$REPO" &
          wineboot -i >/dev/null 2>&1 || :
          wine "$PREFIX/share/win32-demo/hello.exe" >/dev/null 2>&1 &
        ) &
    elif [ -x "$PREFIX/bin/castalia-bienvenida" ]; then
        # warm first impression: the Welcome & Help Center
        ( sleep 3
          "$PREFIX/bin/castalia-bienvenida" --theme "$THEME" \
              --repo "$REPO" &
        ) &
    elif [ -x "$PREFIX/bin/castalia-control-center" ]; then
        ( sleep 3
          "$PREFIX/bin/castalia-control-center" --theme "$THEME" \
              --repo "$REPO" &
        ) &
    fi
fi

wait
rm -rf "$RUNTIME"
log "session ended"
